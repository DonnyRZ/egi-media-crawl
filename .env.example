# =============================================================================
# egi-media-crawl — local / VPS-shaped env template
# Copy to .env:  cp .env.example .env
# Stack ports MUST match docker-compose.yml (S11-A). Do NOT point at editorial
# egi-postgres on 5433 — this service never writes the editorial articles DB.
# =============================================================================

# --- Required: crawl Postgres (host → compose-mapped 5434) ---
# Credentials / DB name match compose: POSTGRES_USER=egi, POSTGRES_PASSWORD=egi,
# POSTGRES_DB=egi_crawl. Host port 5434 → container 5432.
DATABASE_URL=postgresql://egi:egi@localhost:5434/egi_crawl

# --- Required for workers / scheduler (host → compose-mapped 6379) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Read-only HTTP API (npm run api) for CMS / Next.js consumers ---
# Listens on API_PORT. CORS_ORIGINS is comma-separated; defaults cover local CMS + staging.
API_PORT=5050
CORS_ORIGINS=http://localhost:3000,https://staging.egi-media.com

# Honest crawler User-Agent (used on live discover/fetch for non-restricted sources).
CRAWLER_UA=EGIMediaCrawler/0.1 (+https://example.com/crawler; contact=ops@example.com)

# Optional log verbosity hint for operators (info|debug|warn|error). Not all paths read it yet.
LOG_LEVEL=info

# Leave unset/false for fixture-only crawling (default, safe). Set to "true" to let
# adapters discover + fetch live over the network. See README.md
# "CRAWL_LIVE (fixture vs. live crawling)" before enabling this.
CRAWL_LIVE=false

# Caps how many discovered URLs a single discover run processes (crawl:once and the
# crawl-discover worker). Optional while CRAWL_LIVE=false; REQUIRED whenever
# CRAWL_LIVE=true (CLI/worker fail fast otherwise). `--limit=N` on crawl:once overrides.
# NEVER run a live crawl without a limit.
# Example: CRAWL_LIVE=true npm run crawl:once -- --source=detik --limit=2
CRAWL_LIMIT=2

# --- Scheduling (BullMQ job schedulers; needs Redis + long-lived npm start) ---
# Explicit allow-list only — unset means schedule NOTHING (never "all enabled sources").
# Prefer npm scripts over hardcoding the full list (stays in sync with adapters):
#   npm run schedule:staging   # detik,suara @ 2m
#   npm run schedule:all       # all registered adapters (listAdapterIds); fixture-first
# Manual allow-list example (staging pilots):
# SCHEDULE_SOURCES=detik,suara
# Full 17 (same as schedule:all; prefer the npm script so ids stay registry-derived):
# SCHEDULE_SOURCES=detik,viva,suara,cnn_indonesia,liputan6,tirto,tempo,kumparan,jawa_pos,okezone,sindonews,idn_times,republika,media_indonesia,merdeka,beritasatu,tribunnews
# Optional: override every scheduled source's crawl_interval_minutes (e.g. short local soak).
# SCHEDULE_INTERVAL_OVERRIDE_MINUTES=2
# Optional: discover limit for scheduler-enqueued jobs (overrides CRAWL_LIMIT for those).
# Required in practice when CRAWL_LIVE=true (unbounded live schedules are refused).
# SCHEDULE_DISCOVER_LIMIT=2

# --- Reporting (npm run report / report:check; Postgres only, no Redis) ---
# Default window if --since is omitted (e.g. 24h, 30m, 7d, 2w).
# REPORT_SINCE=24h
# Health thresholds for `npm run report:check` (safe defaults: empty/idle DB → exit 0).
# Fail when parse_fail / (stored+duplicate+parse_fail) >= ratio AND denominator >= min total.
# REPORT_PARSE_FAIL_MAX_RATIO=0.5
# REPORT_PARSE_FAIL_MIN_TOTAL=5
# Optional absolute parse_fail cap (unset = off).
# REPORT_PARSE_FAIL_MAX_COUNT=
# Set 1 to require stored+duplicate > 0 (alarms on idle windows — usually leave off).
# REPORT_REQUIRE_STORED=0
# When >0: fail if discovered_urls >= N but stored+duplicate = 0.
# REPORT_MIN_DISCOVERIES=0

# --- Worker / pool tuning (optional) ---
# WORKER_CONCURRENCY=2
# PGPOOL_MAX=10
# PGPOOL_IDLE_TIMEOUT_MS=30000
# PGPOOL_CONNECT_TIMEOUT_MS=5000

# --- Restricted sources only (beritasatu / tribunnews) — see docs/RESTRICTED_UA_POLICY.md ---
# Their edge WAF 403s the plain CRAWLER_UA on live fetch; fetchHtml + those adapters send a
# browser-class UA instead. Optional overrides (default: Chrome-shaped UA + CRAWLER_UA suffix):
# BERITASATU_LIVE_UA=
# TRIBUNNEWS_LIVE_UA=
# Small delay (ms) before a live request to either restricted source (default 800).
# RESTRICTED_LIVE_FETCH_DELAY_MS=800
